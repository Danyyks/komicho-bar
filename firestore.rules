rules_version = '2';

// Regras de segurança do Firestore do Komicho Bar (projeto komicho-ce5ba).
// Só o dono pode ler ou gravar: precisa ser exatamente a conta dele (ID do usuário)
// E estar logado com o e-mail dele, já verificado pelo Google.
// Para liberar outra pessoa no futuro, adicione o ID e o e-mail dela nas listas
// abaixo, o e-mail em RESERVA_EMAILS (src/lib/firebase.ts) e publique as regras.
service cloud.firestore {
  match /databases/{database}/documents {

    // Contas autorizadas (ID do Firebase Authentication)
    function idAutorizado() {
      return request.auth.uid in [
        'NNFz46NJz2gyNk5mujUb3D2MEIh2' // Dany
      ];
    }

    // E-mails autorizados (o login Google entrega o e-mail já verificado)
    function emailAutorizado() {
      return request.auth.token.email_verified == true
        && request.auth.token.email in [
          'danyy.jonathan@gmail.com'
        ];
    }

    function autorizado() {
      return request.auth != null && idAutorizado() && emailAutorizado();
    }

    // Todas as coleções (comandas, clientes, fiado, lancamentos)
    match /{documento=**} {
      allow read, write: if autorizado();
    }
  }
}
