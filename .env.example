# Opcional: a config pública do projeto komicho-ce5ba já está embutida em src/lib/firebase.ts.
# Use um ".env" só para apontar para outro projeto Firebase ou trocar a lista de e-mails.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# E-mails Google que podem entrar no app, separados por vírgula (vazio = só o do dono)
VITE_ALLOWED_EMAILS=
