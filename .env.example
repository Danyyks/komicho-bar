# Copie este arquivo para ".env" e preencha com os dados do seu projeto Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > App da Web).
# Sem estas chaves o app funciona em "modo local" (dados só no aparelho).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# E-mails Google que podem entrar no app, separados por vírgula
VITE_ALLOWED_EMAILS=
